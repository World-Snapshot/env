ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -pthread -B /research/cbim/vast/sf895/miniforge3/envs/WaveGen/compiler_compat -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /research/cbim/vast/sf895/miniforge3/envs/WaveGen/include -fPIC -O2 -isystem /research/cbim/vast/sf895/miniforge3/envs/WaveGen/include -fPIC -I/research/cbim/vast/sf895/miniforge3/envs/WaveGen/lib/python3.11/site-packages/torch/include -I/research/cbim/vast/sf895/miniforge3/envs/WaveGen/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/research/cbim/vast/sf895/miniforge3/envs/WaveGen/include/python3.11 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1018"' -DTORCH_EXTENSION_NAME=_C -std=c++17
cuda_cflags = -I/research/cbim/vast/sf895/miniforge3/envs/WaveGen/lib/python3.11/site-packages/torch/include -I/research/cbim/vast/sf895/miniforge3/envs/WaveGen/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/research/cbim/vast/sf895/miniforge3/envs/WaveGen/include/python3.11 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1018"' -DTORCH_EXTENSION_NAME=_C -gencode=arch=compute_75,code=compute_75 -gencode=arch=compute_75,code=sm_75 -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







build /research/cbim/vast/sf895/code/ControlWorld/env/extensions/vox2seq/build/temp.linux-x86_64-cpython-311/src/api.o: cuda_compile /research/cbim/vast/sf895/code/ControlWorld/env/extensions/vox2seq/src/api.cu
build /research/cbim/vast/sf895/code/ControlWorld/env/extensions/vox2seq/build/temp.linux-x86_64-cpython-311/src/ext.o: compile /research/cbim/vast/sf895/code/ControlWorld/env/extensions/vox2seq/src/ext.cpp
build /research/cbim/vast/sf895/code/ControlWorld/env/extensions/vox2seq/build/temp.linux-x86_64-cpython-311/src/hilbert.o: cuda_compile /research/cbim/vast/sf895/code/ControlWorld/env/extensions/vox2seq/src/hilbert.cu
build /research/cbim/vast/sf895/code/ControlWorld/env/extensions/vox2seq/build/temp.linux-x86_64-cpython-311/src/z_order.o: cuda_compile /research/cbim/vast/sf895/code/ControlWorld/env/extensions/vox2seq/src/z_order.cu








